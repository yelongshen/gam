<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS for the onboard perception container: loopback only, so the bridge/DLIO/mapper
     traffic (point clouds, TF) never reaches eth0, which carries Unitree's low-level control DDS. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
