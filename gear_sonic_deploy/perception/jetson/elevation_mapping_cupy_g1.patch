-        self.elevation_map[4] += self.param.time_interval
+        """Adds the elapsed time to the time layer (seconds since each cell's last update).
+
+        Uses the measured interval rather than a fixed time_interval: the ROS timer that calls this
+        fires late when the node is busy (measured 0.5x real time on a Jetson Orin NX), which made
+        the layer run slow and 'age' meaningless as seconds.
+        """
+        now = time.monotonic()
+        last = getattr(self, "_last_time_update", None)
+        self._last_time_update = now
+        self.elevation_map[4] += self.param.time_interval if last is None else (now - last)
 
