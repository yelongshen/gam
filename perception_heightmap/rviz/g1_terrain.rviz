Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Terrain Patch 11x111
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true

    # ---- The fused elevation map as a 2.5-D surface -----------------------
    # Height Layer / Color Layer are set to `elevation`. Switch both to
    # `elevation_inpainted` in the GUI to view the hole-filled layer produced
    # by postprocessor_pipeline.yaml (only present on the FUSED topic).
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: elevation
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Elevation Map
      Show Grid Lines: true
      Topic: /elevation_mapping/elevation_map
      Unreliable: false
      Use Rainbow: true
      Value: true

    # ---- The 11x11 policy patch from terrain_height_sampler.py ------------
    # Magenta spheres, deliberately large so they read clearly against the
    # map surface. These are the exact 121 points the policy consumes.
    # NOTE: terrain_height_sampler only publishes this cloud when something
    # is subscribed, so it appears once this display is enabled.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 0; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Terrain Patch 11x11
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.045
      Style: Spheres
      Topic: /terrain_height_cloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ---- Raw registered LiDAR scan (what FAST-LIO just saw) ---------------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LiDAR /cloud_registered
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.01
      Style: Points
      Topic: /cloud_registered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ---- Elevation map as a point cloud (raw topic, fastest update) -------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Elevation Cloud (raw)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Boxes
      Topic: /elevation_map_raw_visualization/elevation_cloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        odom_gravity:
          Value: true
        torso_link:
          Value: true
        lidar_link:
          Value: true
      Marker Alpha: 1
      Marker Scale: 0.4
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    # Must be the GRAVITY-ALIGNED frame: the policy patch is horizontal by
    # construction, so viewing it in a tilted frame (odom / odom_torso) would
    # misrepresent it. See gravity_align_publisher.py.
    Fixed Frame: odom_gravity
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: -1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1600
  X: 100
  Y: 100
